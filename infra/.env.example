# ── Postgres
PG_PASSWORD=change_me_long_random

# ── n8n
N8N_HOST=n8n.yourdomain.com
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_USER=you
N8N_PASSWORD=change_me

# ── Knowledge Base + product intake (single web service)
KB_PASSWORD=change_me

# ── LLM via 9router (OpenAI-compatible). 9router runs on the host.
LLM_BASE_URL=http://host.docker.internal:9000/v1
LLM_API_KEY=
LLM_MODEL_MINE=gemini-2.5-pro
LLM_MODEL_EMBED=text-embedding-3-small

# ── Image hosting: Cloudflare R2 (public bucket, free tier, zero egress cost).
# Images must be on a publicly reachable HTTPS URL so Meta can fetch them server-side.
# Create an R2 bucket, enable public access via a Custom Domain or r2.dev, then fill in:
IMAGE_BACKEND=s3
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=threadsflow
S3_KEY=
S3_SECRET=
PUBLIC_IMAGE_BASE=https://cdn.yourdomain.com  # the public hostname that fronts your R2 bucket
# If you prefer local storage (the kb service serves /img), set IMAGE_BACKEND=local and
# point cdn.yourdomain.com → http://kb:8082 in Cloudflare Tunnel.

# ── redirector
IP_SALT=generate_with_openssl_rand_hex_16

# ── Cloudflare Tunnel
CF_TUNNEL_TOKEN=paste_from_zero_trust_dashboard

# ── Secrets that live in the DB `settings` table, not here:
#    threads_token, threads_user_id, 9router_key, apify_token, shopee_app_id/secret
