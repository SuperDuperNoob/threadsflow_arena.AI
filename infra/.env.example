# ── Postgres (the database)
# This is the master password for your database. Make it long and random.
# Generate one:  openssl rand -base64 24
PG_PASSWORD=change_me_long_random

# ── n8n (the automation dashboard you open in your browser)
# The web address where you will access n8n. Replace with your domain.
N8N_HOST=n8n.yourdomain.com
# A random 64-character hex string. Generate:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
# The username and password you will use to log into n8n's web interface.
N8N_USER=you
N8N_PASSWORD=change_me

# ── Knowledge Base (product upload + PDF upload web UI)
# Password for the forms at kb.yourdomain.com. Behind Cloudflare Access,
# this is belt-and-braces — but still set a strong one.
KB_PASSWORD=change_me

# ── LLM / AI (where the system sends requests to write posts)
# 9router is a tiny proxy that runs on your VPS. It forwards requests to
# whichever AI provider (OpenAI, Google, Anthropic) is cheapest or best for
# each task. Install it once with:  9router serve --port 9000
#
# If you do NOT use 9router, point this at one provider directly:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...

LLM_BASE_URL=http://host.docker.internal:9000/v1
LLM_API_KEY=
LLM_MODEL_MINE=gemini-2.5-pro
LLM_MODEL_EMBED=text-embedding-3-small

# ═══════════════════════════════════════════════════════════════
# ── Image hosting: Cloudflare R2
# ═══════════════════════════════════════════════════════════════
#
# Threads fetches images server-side — they MUST be on a public HTTPS
# URL. Cloudflare R2 is free: 10 GB storage, zero egress fees. Meta
# downloading your images costs nothing.
#
# Full click-by-click setup: docs/03-setup-runbook.md Step 3b.
# Quick reference for what each value is:
#
#   IMAGE_BACKEND = "s3" to use R2. "local" to store images on the VPS disk
#                   instead (not recommended — Meta's fetches eat your bandwidth).
#
#   S3_ENDPOINT   = the private API address the code uploads images TO
#                   (from the R2 token creation screen)
#
#   S3_BUCKET     = the bucket name you created ("threadsflow"). Must match.
#
#   S3_KEY        = Access Key ID — the "username" half of the API token
#                   (from the R2 token creation screen)
#
#   S3_SECRET     = Secret Access Key — the "password" half of the API token
#                   (from the R2 token creation screen — you only see this once)
#
#   PUBLIC_IMAGE_BASE = the public URL where images are served FROM.
#                   r2.dev subdomain:  https://pub-abc123.r2.dev
#                   Custom domain:     https://cdn.yourdomain.com
#                   No trailing slash. Do NOT include the bucket name for
#                   custom domains.
#
# Image uploads are signed with SigV4 so only someone holding
# S3_KEY + S3_SECRET can write. Read access is public so Meta can fetch.

IMAGE_BACKEND=s3
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=threadsflow
S3_KEY=
S3_SECRET=
PUBLIC_IMAGE_BASE=https://cdn.yourdomain.com

# ── Redirector (link shortener + click tracker)
# A random salt used to hash visitor IP addresses (for privacy).
# Generate:  openssl rand -hex 16
IP_SALT=generate_with_openssl_rand_hex_16

# ── Cloudflare Tunnel (the secure pipe from your VPS to the internet)
# Copy the token from Cloudflare Zero Trust → Tunnels → your tunnel.
# It starts with "eyJh..." and is a very long string.
CF_TUNNEL_TOKEN=paste_from_zero_trust_dashboard

# ── Shopee Affiliate Open API (product price/commission + conversion reporting)
# Get these from your affiliate dashboard → Open API section:
#   MY: https://affiliate.shopee.com.my/dashboard  →  Open API  →  create App ID + API Key
# The app_id/secret are read from HERE first, then (if blank) from the `settings` table
# rows `shopee_app_id` / `shopee_app_secret` (inserted via raw SQL in Step 2.5).
# Endpoint defaults to Malaysia; override for other countries if needed.
SHOPEE_API_APP_ID=
SHOPEE_API_SECRET=
# SHOPEE_OPENAPI_URL=https://open-api.affiliate.shopee.com.my/graphql
# SHOPEE_LOOKBACK_DAYS=7          # conversion sync window
# SHOPEE_VALIDATION_ID=           # only for the billing-validated report (--validate)

# ── Secrets stored in the DB `settings` table, NOT here:
#    These are inserted with raw SQL in Step 2.5 of the runbook.
#    threads_token, threads_user_id, 9router_key, apify_token, shopee_app_id/secret
