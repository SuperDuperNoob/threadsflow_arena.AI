# ── Postgres
PG_PASSWORD=change_me_long_random

# ── n8n
N8N_HOST=n8n.yourdomain.com
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_USER=you
N8N_PASSWORD=change_me

# ── UI
UI_PASSWORD=change_me

# ── redirector
IP_SALT=generate_with_openssl_rand_hex_16

# ── MinIO (skip if using Cloudflare R2)
MINIO_USER=threadsflow
MINIO_PASSWORD=change_me_long_random
MINIO_PUBLIC_BASE=https://cdn.yourdomain.com/threadsflow

# ── Cloudflare Tunnel
CF_TUNNEL_TOKEN=paste_from_zero_trust_dashboard

# ── Secrets that live in the DB `settings` table, not here:
