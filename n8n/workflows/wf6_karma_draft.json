{
  "name": "wf6_karma (DRAFT - Pending Meta API Public Search)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "cron",
      "name": "Every 6 Hours (Draft Trigger)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, 300],
      "notes": "DRAFT WORKFLOW: On hold until Meta releases public search API endpoints for Threads."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, uid, name, COALESCE(enrichment->>'category', notes, name) AS category_hint, notes, enrichment FROM products WHERE status='active' ORDER BY random() LIMIT 3;",
        "options": {}
      },
      "id": "pick_seeds",
      "name": "Pick 3 Product Seeds",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-380, 300],
      "credentials": {
        "postgres": {
          "id": "PG",
          "name": "Postgres threadsflow"
        }
      }
    },
    {
      "parameters": {
        "url": "https://graph.threads.net/v1.0/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.category_hint }} tips"
            },
            {
              "name": "media_type",
              "value": "TEXT"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "search_placeholder",
      "name": "Threads Search API (PLACEHOLDER)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
