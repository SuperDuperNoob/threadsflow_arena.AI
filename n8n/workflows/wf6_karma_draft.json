    },
    {
      "parameters": {
        "url": "https://graph.threads.net/v1.0/{{ $json.thread_id }}/replies",
        "method": "POST",
        "options": {}
      },
      "id": "publish_placeholder",
      "name": "Publish Reply API (PLACEHOLDER)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300],
