    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO run_log (workflow, level, message, meta) VALUES ('wf6_karma', 'draft_info', 'posted draft karma comment', $1::jsonb);",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
      },
      "id": "audit_log",
