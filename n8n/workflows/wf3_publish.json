{
  "name": "wf3_publish",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -820,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT value FROM settings WHERE key = 'threads_creds'\n),\nauto_timeout AS (\n  UPDATE post_review\n  SET status = 'auto_published', reviewed_at = now(), reviewed_by = 'timeout_scheduler'\n  WHERE status = 'pending_review' AND timeout_at <= now()\n  RETURNING post_id\n),\naudit_timeout AS (\n  INSERT INTO post_review_audit (post_id, decision_type, meta)\n  SELECT post_id, 'timeout_auto_publish', jsonb_build_object('reason', 'timeout reached without human review')\n  FROM auto_timeout\n),\ndue AS (\nSELECT p.*, pr.affiliate_url, pr.uid AS product_uid, pr.media_mode,\n       COALESCE(rev.edited_body, p.body) AS body,\n       (SELECT array_agg(pi.public_url ORDER BY pi.id)\n          FROM product_images pi WHERE pi.id = ANY(p.image_ids)) AS image_urls,\n       (SELECT value->>'token'   FROM s) AS token,\n       (SELECT value->>'user_id' FROM s) AS user_id\n  FROM posts p\n  JOIN post_review rev ON rev.post_id = p.id\n  JOIN products pr ON pr.id = p.product_id\n WHERE p.status = 'queued'\n   AND p.scheduled_at <= now()\n   AND rev.status IN ('approved', 'auto_published')\n   AND (rev.under_review_until IS NULL OR rev.under_review_until < now())\n ORDER BY p.scheduled_at\n LIMIT 1\n), ckpt AS (\n  INSERT INTO run_log (workflow, level, message, meta)\n  SELECT 'wf3_publish','debug','due post fetched',\n         jsonb_build_object('uid', due.uid, 'media_type', due.media_type,\n                            'scheduled_at', due.scheduled_at)\n  FROM due RETURNING 1\n)\nSELECT * FROM due;",
        "options": {}
      },
      "id": "fetch",
      "name": "Fetch due post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -600,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PG",
          "name": "Postgres threadsflow"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has_post",
      "name": "Any post due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.threads.net/v1.0/{{ $json.user_id }}/threads_publishing_limit",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "quota_usage,config"
            },
            {
              "name": "access_token",
              "value": "={{ $json.token }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "quota",
      "name": "Check quota",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const post  = $('Fetch due post').first().json;\nconst quota = $json?.data?.[0]?.quota_usage ?? 0;\nconst total = $json?.data?.[0]?.config?.quota_total ?? 250;\nif (quota >= Math.min(200, total - 20)) {\n  return [{ json: { ...post, abort: true, reason: `quota ${quota}/${total}` } }];\n}\n\nconst urls = (post.image_urls || []).filter(Boolean);\n// Trust the column, but never trust it blindly: if media_type claims images and none resolved\n// (deleted file, broken CDN), fall back to TEXT rather than sending Meta a null image_url.\n// A text post is a fine post. A failed API call is 30 wasted seconds and a lost slot.\nlet media_type = post.media_type || (urls.length ? 'IMAGE' : 'TEXT');\nif (media_type !== 'TEXT' && urls.length === 0) media_type = 'TEXT';\nif (media_type === 'CAROUSEL' && urls.length < 2) media_type = urls.length === 1 ? 'IMAGE' : 'TEXT';\nif (media_type === 'IMAGE' && urls.length > 1) urls.length = 1;\n\nreturn [{ json: { ...post, abort: false, quota, image_urls: urls, media_type,\n                  is_text: media_type === 'TEXT',\n                  is_carousel: media_type === 'CAROUSEL',\n                  wait_seconds: media_type === 'TEXT' ? 3 : 35 } }];"
      },
      "id": "guard",
      "name": "Quota guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH locked AS (\n  UPDATE posts SET status = 'publishing' WHERE id = $1 AND status = 'queued' RETURNING id\n), ckpt AS (\n  INSERT INTO run_log (workflow, level, message, meta)\n  SELECT 'wf3_publish','debug','post locked: quota checked', $2::jsonb FROM locked RETURNING 1\n)\nSELECT id FROM locked;",
        "options": {
          "queryReplacement": "={{ $json.id }},={{ JSON.stringify({uid: $json.uid, quota: $json.quota, media_type: $json.media_type, abort: $json.abort === true}) }}"
        }
      },
      "id": "lock",
      "name": "Lock row",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        280,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "PG",
          "name": "Postgres threadsflow"
        }
      },
      "notes": "Optimistic lock: if two runs overlap, only one gets a row back."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.threads.net/v1.0/{{ $('Quota guard').first().json.user_id }}/threads",
