      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT value FROM settings WHERE key = 'threads_creds'\n),\nauto_timeout AS (\n  UPDATE posts\n     SET status = 'auto_published'\n   WHERE status = 'pending_review'\n     AND review_timeout_at <= now()\n     AND (review_locked_until IS NULL OR review_locked_until < now())\n   RETURNING id\n),\naudit_timeout AS (\n  INSERT INTO post_review (post_id, decision, reviewed_by, reason_note)\n  SELECT id, 'auto_published', 'timeout_scheduler', 'timeout reached without human review'\n  FROM auto_timeout\n),\ndue AS (\nSELECT p.*, p.id::int AS id, pr.affiliate_url, pr.uid AS product_uid, pr.media_mode,\n       COALESCE(rev.edited_body, p.body) AS body,\n       (SELECT array_agg(pi.public_url ORDER BY pi.id)\n          FROM product_images pi WHERE pi.id = ANY(p.image_ids) AND pi.media_kind = 'IMAGE') AS image_urls,\n       (SELECT array_agg(pi.public_url ORDER BY pi.id)\n          FROM product_images pi WHERE pi.id = ANY(p.image_ids) AND pi.media_kind = 'VIDEO') AS video_urls,\n       (SELECT jsonb_agg(jsonb_build_object('id', pi.id, 'public_url', pi.public_url, 'media_kind', pi.media_kind) ORDER BY pi.id)\n          FROM product_images pi WHERE pi.id = ANY(p.image_ids)) AS product_images,\n       (SELECT value->>'token'   FROM s) AS token,\n       (SELECT value->>'user_id' FROM s) AS user_id\n  FROM posts p\n  LEFT JOIN LATERAL (\n    SELECT edited_body FROM post_review\n     WHERE post_id = p.id AND edited_body IS NOT NULL\n     ORDER BY id DESC LIMIT 1\n  ) rev ON true\n  JOIN products pr ON pr.id = p.product_id\n WHERE p.status IN ('approved', 'auto_published')\n   AND p.scheduled_at <= now()\n   AND (p.review_locked_until IS NULL OR p.review_locked_until < now())\n ORDER BY p.scheduled_at\n LIMIT 1\n), ckpt AS (\n  INSERT INTO run_log (workflow, level, message, meta)\n  SELECT 'wf3_publish','debug','due post fetched',\n         jsonb_build_object('uid', due.uid, 'media_type', due.media_type,\n                            'scheduled_at', due.scheduled_at)\n  FROM due RETURNING 1\n)\nSELECT * FROM due;",
        "options": {}
      },
