        "operation": "executeQuery",
        "query": "UPDATE posts SET threads_reply_id = $2 WHERE id = $1;\nUPDATE product_images SET use_count = use_count + 1, last_used_at = now()\n WHERE id = ANY((SELECT COALESCE(image_ids,'{}') FROM posts WHERE id = $1));\nINSERT INTO run_log (workflow, level, message, meta)\nVALUES ('wf3_publish','info','CTA reply published', jsonb_build_object('uid', $3::text));",
        "options": {
