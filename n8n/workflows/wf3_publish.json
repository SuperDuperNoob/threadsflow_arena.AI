    {
      "parameters": {
        "jsCode": "const post  = $('Fetch due post').first().json;\nconst quota = $json?.data?.[0]?.quota_usage ?? 0;\nconst total = $json?.data?.[0]?.config?.quota_total ?? 250;\nif (quota >= Math.min(200, total - 20)) {\n  return [{ json: { ...post, abort: true, reason: `quota ${quota}/${total}` } }];\n}\n\nconst imageUrls = (post.image_urls || []).filter(Boolean);\nconst videoUrls = (post.video_urls || []).filter(Boolean);\nconst productImages = (post.product_images || []).filter(p => p.public_url);\n\n// Use wf3_media_router logic inline (since n8n Code nodes can't import)\nconst valid = ['TEXT','IMAGE','CAROUSEL','VIDEO','MIXED_CAROUSEL'];\nlet media_type = post.media_type;\nif (!media_type || !valid.includes(media_type)) {\n  const hasVideo = productImages.some(p => p.media_kind === 'VIDEO');\n  const hasImage = productImages.some(p => p.media_kind === 'IMAGE') || imageUrls.length > 0;\n  if (hasVideo && hasImage) media_type = 'MIXED_CAROUSEL';\n  else if (hasVideo) media_type = 'VIDEO';\n  else if (hasImage) media_type = imageUrls.length > 1 ? 'CAROUSEL' : 'IMAGE';\n  else media_type = 'TEXT';\n}\n\n// Existing guards for legacy types\nif (!['VIDEO','MIXED_CAROUSEL'].includes(media_type)) {\n  if (media_type !== 'TEXT' && imageUrls.length === 0) media_type = 'TEXT';\n  if (media_type === 'CAROUSEL' && imageUrls.length < 2) {\n    media_type = imageUrls.length === 1 ? 'IMAGE' : 'TEXT';\n  }\n  if (media_type === 'IMAGE' && imageUrls.length > 1) imageUrls.length = 1;\n}\n\nconst hasVideo = productImages.some(p => p.media_kind === 'VIDEO') || media_type === 'VIDEO';\nconst needsVideoPoll = (media_type === 'VIDEO') ||\n  (media_type === 'MIXED_CAROUSEL' && productImages.some(p => p.media_kind === 'VIDEO'));\n\nconst waitSeconds = media_type === 'TEXT' ? 3 : (needsVideoPoll ? 60 : 35);\n\nreturn [{ json: { ...post, abort: false, quota, image_urls: imageUrls, video_urls: videoUrls, product_images: productImages, media_type,\n                  is_text: media_type === 'TEXT',\n                  is_carousel: media_type === 'CAROUSEL',\n                  is_video: media_type === 'VIDEO',\n                  is_mixed_carousel: media_type === 'MIXED_CAROUSEL',\n                  needs_video_poll: needsVideoPoll,\n                  wait_seconds: waitSeconds } }];"
      },
