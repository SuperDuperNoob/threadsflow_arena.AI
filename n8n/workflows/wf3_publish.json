        "query": "UPDATE posts SET status='failed', fail_reason=$2 WHERE id=$1;\nINSERT INTO run_log (workflow, level, message, meta) VALUES ('wf3_publish','error','publish failed',$2::jsonb);",
        "options": {
          "queryReplacement": "={{ $('Quota guard').first().json.id }},={{ JSON.stringify({node: $prevNode.name, error: String(($json.error && ($json.error.message || $json.error.description)) || $json.message || 'unknown').slice(0, 300)}).slice(0, 500) }}"
