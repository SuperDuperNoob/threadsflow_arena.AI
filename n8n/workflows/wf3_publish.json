            },
            {
              "name": "access_token",
              "value": "={{ $('Quota guard').first().json.token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "container_image",
      "name": "Create IMAGE container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 8000,
      "onError": "continueErrorOutput",
      "notes": "For carousels: loop images with is_carousel_item=true, then media_type=CAROUSEL&children=..."
    },
    {
