    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH pub AS (\n  UPDATE posts SET status='published', threads_media_id=$2, published_at=now() WHERE id=$1\n  RETURNING uid, sell_intensity, cta_text, tracked_url, reply_delay_sec, image_ids, media_type, char_count\n), ckpt AS (\n  INSERT INTO run_log (workflow, level, message, meta)\n  SELECT 'wf3_publish','info','post published',\n         jsonb_build_object('uid', pub.uid, 'media_type', pub.media_type, 'char_count', pub.char_count)\n  FROM pub RETURNING 1\n)\nSELECT uid, sell_intensity, cta_text, tracked_url, reply_delay_sec, image_ids FROM pub;",
        "options": {
          "queryReplacement": "={{ $('Quota guard').first().json.id }},={{ $json.id }}"
        }
      },
      "id": "mark_published",
      "name": "Mark published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1700,
        220
